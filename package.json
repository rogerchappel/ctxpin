{
  "name": "ctxpin",
  "version": "0.1.0",
  "description": "Local-first deterministic context bundles for agent workflows.",
  "type": "module",
  "bin": {
    "ctxpin": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js",
    "check": "tsc --noEmit",
    "test": "npm run build && rm -rf dist-test && tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "cli",
    "context",
    "agent",
    "bundle",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/ctxpin.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/ctxpin/issues"
  },
  "homepage": "https://github.com/rogerchappel/ctxpin#readme"
}
